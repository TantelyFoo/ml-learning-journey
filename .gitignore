# Machine Learning Project .gitignore
# Comprehensive .gitignore for ML/Data Science projects

# ==============================================================================
# PYTHON
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# ==============================================================================
# JUPYTER NOTEBOOKS
# ==============================================================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# ==============================================================================
# DATA FILES (Large files should not be in Git)
# ==============================================================================
# CSV files
*.csv
*.tsv

# Excel files
*.xlsx
*.xls

# JSON files (large ones)
large_data.json
**/data/raw/**
**/data/processed/**
**/data/interim/**

# Database files
*.db
*.sqlite
*.sqlite3

# HDF5 files
*.h5
*.hdf5

# Pickle files
*.pkl
*.pickle

# Parquet files
*.parquet

# ==============================================================================
# MACHINE LEARNING MODELS
# ==============================================================================
# Trained models
*.model
*.joblib
*.pkl
*.pt
*.pth
*.h5
*.hdf5
*.pb
*.onnx
*.tflite

# Model directories
models/
checkpoints/
saved_models/
logs/
runs/

# TensorFlow
*.tfrecord
*.tfrecords

# PyTorch
*.pth
*.tar

# ==============================================================================
# EXPERIMENT TRACKING
# ==============================================================================
# MLflow
mlruns/
mlflow_tracking/

# Weights & Biases
wandb/

# TensorBoard
tensorboard_logs/
tb_logs/

# Neptune
.neptune/

# ==============================================================================
# CONFIGURATION FILES
# ==============================================================================
# Environment variables
.env
.env.local
.env.*.local

# Configuration files with secrets
config/secrets.yml
config/api_keys.json
**/config/local_config.py

# ==============================================================================
# DATASETS (Keep small sample data, ignore large datasets)
# ==============================================================================
# Large datasets
datasets/large/
datasets/raw/
datasets/processed/
data/raw/
data/processed/
data/interim/
data/external/

# But keep small sample data for examples
!datasets/samples/
!data/samples/

# ==============================================================================
# OUTPUTS AND RESULTS
# ==============================================================================
# Generated reports
reports/generated/
outputs/
results/
plots/
figures/

# Temporary files
tmp/
temp/
*.tmp

# ==============================================================================
# DEVELOPMENT TOOLS
# ==============================================================================
# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==============================================================================
# DOCKER
# ==============================================================================
# Docker files (if using containerization)
.dockerignore
docker-compose.override.yml

# ==============================================================================
# CLOUD CREDENTIALS
# ==============================================================================
# AWS
.aws/
*.pem

# Google Cloud
*.json
gcloud_key.json
service_account.json

# Azure
.azure/

# ==============================================================================
# DOCUMENTATION BUILD
# ==============================================================================
# Sphinx documentation
docs/_build/

# mkdocs documentation
/site

# ==============================================================================
# PERFORMANCE PROFILING
# ==============================================================================
*.prof
*.lprof
*.py.prof

# ==============================================================================
# CUSTOM PROJECT SPECIFIC
# ==============================================================================
# Add your project-specific ignores here
# For example:
# my_custom_folder/
# specific_file.txt
